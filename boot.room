export function WHIRL_CORE(v, t){
    const w = Math.sin(v.x + v.y + v.z + t * 0.33);

    return {
        S1: w * 0.5,
        S2: w * 0.75,
        S3: w * 1.25,
        S4: (v.x + v.y + v.z) * w,
        core: w,
        seq: [w, w*2, w*3, w*4]
    };
}
export function WHIRL_VEC(v, t){
    const w = WHIRL_CORE(v, t);

    return {
        x: v.x + w.S1,
        y: v.y + w.S2,
        z: v.z + w.S3,
        seq: w.seq,
        whirl: w
    };
}
export function VECTOR_Whirl(v, t){
    return WHIRL_VEC(v, t);
}
export function TMP_Whirl(v){
    TMP.B = v.whirl.S1;
    TMP.H = v.whirl.S2;
    TMP.T = v.whirl.S3;
    TMP.seq = v.seq;
}
export function PQ_HOOK(v){
    PQ.push({
        depth: v.whirl.S4,
        seq: v.seq,
        core: v.whirl.core
    });
}
